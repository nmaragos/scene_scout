#usda 1.0
(
    defaultPrim = "Chair"
)

def Xform "Chair"
{
    def Cube "Seat"
    {
        double size = 1
        double3 xformOp:scale = (0.8, 0.12, 0.7)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }
    def Cube "Back"
    {
        double3 xformOp:scale = (0.8, 0.65, 0.1)
        double3 xformOp:translate = (0, 0.62, -0.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
