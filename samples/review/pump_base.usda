#usda 1.0

def Xform "Pump" (kind = "component")
{
    def Cube "Base"
    {
        double size = 2
        float3 xformOp:scale = (1.3, 0.09, 0.65)
        uniform token[] xformOpOrder = ["xformOp:scale"]
        color3f[] primvars:displayColor = [(0.23, 0.29, 0.34)]
    }

    def Cube "Housing" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 2
        double3 xformOp:translate = (-0.26, 0.59, 0)
        float3 xformOp:scale = (0.74, 0.51, 0.49)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </Pump/Looks/BluePaint>
    }

    def Cylinder "Inlet"
    {
        uniform token axis = "Y"
        double height = 0.37
        double radius = 0.28
        double3 xformOp:translate = (-0.26, 1.25, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.38, 0.44, 0.47)]
    }

    def Xform "Bracket" (
        prepend variantSets = "mount"
        variants = { string mount = "standard" }
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Support"
        {
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.31, 0.37, 0.42)]
        }

        variantSet "mount" = {
            "standard" {
                over "Support"
                {
                    double3 xformOp:translate = (0.66, 0.33, 0)
                    float3 xformOp:scale = (0.14, 0.24, 0.30)
                }
            }
            "tall" {
                over "Support"
                {
                    double3 xformOp:translate = (0.66, 0.48, 0)
                    float3 xformOp:scale = (0.14, 0.39, 0.30)
                }
            }
        }
    }

    def Scope "Looks"
    {
        def Material "BluePaint"
        {
            token outputs:surface.connect = </Pump/Looks/BluePaint/Preview.outputs:surface>
            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.27, 0.43)
                float inputs:metallic = 0.1
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Copper"
        {
            token outputs:surface.connect = </Pump/Looks/Copper/Preview.outputs:surface>
            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.23, 0.095)
                float inputs:metallic = 0.25
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }
    }
}
