#usda 1.0
(
    defaultPrim = "Publish"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 48
    timeCodesPerSecond = 24
    subLayers = [@./signoff_assets/set_dressing.usda@]
)

def Xform "Publish"
{
    def Xform "Chair" (
        prepend references = @./signoff_assets/chair_v013.usda@
    )
    {
        double3 xformOp:translate = (-2, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "MissingLamp" (prepend references = @./signoff_assets/lamp_missing.usda@)
    {
    }

    def Xform "Extras" (
        prepend payload = @./signoff_assets/extras.usda@
    )
    {
        double3 xformOp:translate = (4, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "AnimatedProp"
    {
        double radius = 0.45
        double3 xformOp:translate.timeSamples = {
            1: (0, 1, 0),
            48: (2, 1, 0)
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "NewMarker" {}
}
