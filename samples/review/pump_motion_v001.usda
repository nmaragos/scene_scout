#usda 1.0
(
    defaultPrim = "Pump"
    startTimeCode = 1
    endTimeCode = 72
    timeCodesPerSecond = 24
    framesPerSecond = 24
    metersPerUnit = 1
    upAxis = "Y"
    subLayers = [@pump_base.usda@]
)

over "Pump"
{
    over "Bracket"
    {
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:translate.timeSamples = {
            1: (0, 0, 0),
            48: (0.3, 0, 0),
            72: (0, 0, 0),
        }
    }
}
